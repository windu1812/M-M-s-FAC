{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(py -0p)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/bin/python --version)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python -m pip list *)",
      "Bash(.venv/bin/python -m pip check)",
      "Bash(.venv/bin/python manage.py test *)",
      "Bash(.venv/bin/python manage.py check *)",
      "Bash(.venv/bin/python manage.py makemigrations --check *)",
      "Bash(.venv/bin/python checks/browser_check.py *)",
      "Bash(ls *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(/.env)",
      "Read(/app/.env)",
      "Read(/**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.production)",
      "Read(/**/.streamlit/secrets.toml)",
      "Read(./**/.streamlit/secrets.toml)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.production)",
      "Edit(/**/.streamlit/secrets.toml)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ]
  }
}
